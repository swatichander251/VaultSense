# Copy to .env on the server (never commit .env). Generate keys with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
VAULTSENSE_API_KEY=
VAULTSENSE_AUDIT_KEY=

# Supabase -> Project Settings -> API. Use the anon/publishable key, NOT service_role.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Extra allowed frontend origins, comma separated (Lovable domains are allowed by default)
ALLOWED_ORIGINS=http://localhost:5173

# Chatbot guard
ALLOWED_LINK_DOMAINS=yourbank.com
CHATBOT_AUTO_LIMIT=1000

# Server-only Supabase key: lets the server log guard events, write fraud scores and run
# confirmed transfers. NEVER put this in Lovable, the browser, or GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Demo chatbot brain. "mock" works with no key. Or:
#   LLM_PROVIDER=openai     LLM_API_KEY=...  LLM_MODEL=gpt-4o-mini  (LLM_BASE_URL for Groq/OpenRouter/Ollama etc.)
#   LLM_PROVIDER=anthropic  LLM_API_KEY=...  LLM_MODEL=claude-haiku-5-5
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1

# Lets the demo page turn the guard OFF to show an attack succeeding (synthetic data only,
# never for signed-in Supabase users). Set false for anything real.
DEMO_ALLOW_GUARD_OFF=true
BANK_TIMEZONE=America/Chicago
